diff --git a/video/out/vo_avlayer.m b/video/out/vo_avlayer.m
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/video/out/vo_avlayer.m
@@ -0,0 +1,409 @@
+/*
+ * Battery-saving video output with subtitle overlay.
+ *
+ * Feeds CVPixelBuffers from VideoToolbox to an AVSampleBufferDisplayLayer
+ * for the video, and renders subtitles/OSD to a separate transparent
+ * CALayer on top using CoreGraphics.
+ *
+ * This bypasses the Vulkan/libplacebo/MoltenVK pipeline, using Apple's
+ * native compositing instead (same path as AVPlayer). Subtitle bitmaps
+ * are obtained from mpv's OSD subsystem and drawn to a CGBitmapContext.
+ *
+ * WinID must point to an NSArray containing:
+ *   [0] AVSampleBufferDisplayLayer (for video)
+ *   [1] CALayer (for subtitle overlay, must be transparent)
+ *
+ * This VO only accepts IMGFMT_VIDEOTOOLBOX frames.
+ */
+
+#import <AVFoundation/AVFoundation.h>
+#import <CoreMedia/CoreMedia.h>
+#import <CoreVideo/CoreVideo.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+#include <libavutil/hwcontext.h>
+
+#include "common/msg.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+#include "video/hwdec.h"
+#include "sub/osd.h"
+#include "vo.h"
+
+struct priv {
+    AVSampleBufferDisplayLayer *video_layer;
+    CALayer *subtitle_layer;
+    CMTimebaseRef timebase;
+    struct mp_hwdec_ctx hwctx;
+    int src_width;
+    int src_height;
+    int64_t last_sub_change_id;
+};
+
+static CMSampleBufferRef create_sample_buffer(CVPixelBufferRef pixbuf,
+                                               CMTimebaseRef timebase)
+{
+    if (!pixbuf)
+        return NULL;
+
+    CMVideoFormatDescriptionRef fmt_desc = NULL;
+    OSStatus status = CMVideoFormatDescriptionCreateForImageBuffer(
+        kCFAllocatorDefault, pixbuf, &fmt_desc);
+    if (status != noErr || !fmt_desc)
+        return NULL;
+
+    CMTime pts = CMTimebaseGetTime(timebase);
+    CMSampleTimingInfo timing = {
+        .duration = kCMTimeInvalid,
+        .presentationTimeStamp = pts,
+        .decodeTimeStamp = kCMTimeInvalid,
+    };
+
+    CMSampleBufferRef sample_buf = NULL;
+    status = CMSampleBufferCreateReadyWithImageBuffer(
+        kCFAllocatorDefault, pixbuf, fmt_desc, &timing, &sample_buf);
+    CFRelease(fmt_desc);
+
+    if (status != noErr)
+        return NULL;
+
+    CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(
+        sample_buf, true);
+    if (attachments && CFArrayGetCount(attachments) > 0) {
+        CFMutableDictionaryRef dict =
+            (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
+        CFDictionarySetValue(dict,
+            kCMSampleAttachmentKey_DisplayImmediately, kCFBooleanTrue);
+    }
+
+    return sample_buf;
+}
+
+// Callback for osd_draw — renders each subtitle bitmap part to the CG context.
+struct sub_draw_ctx {
+    CGContextRef cg_ctx;
+    int canvas_w;
+    int canvas_h;
+    struct vo *vo;
+};
+
+static void draw_sub_bitmaps(void *ctx, struct sub_bitmaps *imgs)
+{
+    struct sub_draw_ctx *d = ctx;
+    if (!imgs || imgs->num_parts == 0)
+        return;
+
+    for (int i = 0; i < imgs->num_parts; i++) {
+        struct sub_bitmap *sb = &imgs->parts[i];
+
+        if (imgs->format == SUBBITMAP_BGRA) {
+            // BGRA bitmap — create CGImage and draw it
+            CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
+            CGContextRef bmp_ctx = CGBitmapContextCreate(
+                sb->bitmap, sb->w, sb->h, 8, sb->stride,
+                cs,
+                kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst);
+            if (bmp_ctx) {
+                CGImageRef img = CGBitmapContextCreateImage(bmp_ctx);
+                if (img) {
+                    // CG has flipped Y axis
+                    CGRect rect = CGRectMake(sb->x, d->canvas_h - sb->y - sb->dh,
+                                             sb->dw, sb->dh);
+                    CGContextDrawImage(d->cg_ctx, rect, img);
+                    CGImageRelease(img);
+                }
+                CGContextRelease(bmp_ctx);
+            }
+            CGColorSpaceRelease(cs);
+        } else if (imgs->format == SUBBITMAP_LIBASS) {
+            // A8 alpha mask with solid color — composite manually
+            uint32_t color = sb->libass.color;
+            // libass color: 0xRRGGBBAA (AA=transparency, 0=opaque, 255=transparent)
+            CGFloat r = ((color >> 24) & 0xFF) / 255.0;
+            CGFloat g = ((color >> 16) & 0xFF) / 255.0;
+            CGFloat b = ((color >>  8) & 0xFF) / 255.0;
+            CGFloat a = 1.0 - ((color >>  0) & 0xFF) / 255.0;
+
+            // Create alpha mask from A8 bitmap
+            CGColorSpaceRef gray = CGColorSpaceCreateDeviceGray();
+            CGContextRef mask_ctx = CGBitmapContextCreate(
+                sb->bitmap, sb->w, sb->h, 8, sb->stride,
+                gray, kCGImageAlphaNone);
+            if (mask_ctx) {
+                CGImageRef mask = CGBitmapContextCreateImage(mask_ctx);
+                if (mask) {
+                    CGRect rect = CGRectMake(sb->x, d->canvas_h - sb->y - sb->dh,
+                                             sb->dw, sb->dh);
+                    // Clip to the alpha mask and fill with the solid color
+                    CGContextSaveGState(d->cg_ctx);
+                    CGContextClipToMask(d->cg_ctx, rect, mask);
+                    CGContextSetRGBFillColor(d->cg_ctx, r, g, b, a);
+                    CGContextFillRect(d->cg_ctx, rect);
+                    CGContextRestoreGState(d->cg_ctx);
+                    CGImageRelease(mask);
+                }
+                CGContextRelease(mask_ctx);
+            }
+            CGColorSpaceRelease(gray);
+        }
+    }
+}
+
+static void render_subtitles(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    if (!vo->osd || !p->subtitle_layer || p->src_width <= 0 || p->src_height <= 0)
+        return;
+
+    // Use the layer's pixel dimensions for OSD rendering so subtitles
+    // appear at the same size as gpu-next (which renders at display resolution).
+    __block int layer_w = p->src_width;
+    __block int layer_h = p->src_height;
+    dispatch_sync(dispatch_get_main_queue(), ^{
+        CGFloat scale = p->subtitle_layer.contentsScale;
+        if (scale < 1) scale = 1;
+        layer_w = (int)(p->subtitle_layer.bounds.size.width * scale);
+        layer_h = (int)(p->subtitle_layer.bounds.size.height * scale);
+    });
+    if (layer_w <= 0 || layer_h <= 0) {
+        layer_w = p->src_width;
+        layer_h = p->src_height;
+    }
+
+    struct mp_osd_res osd_res = {
+        .w = layer_w,
+        .h = layer_h,
+    };
+
+    double pts = frame->current ? frame->current->pts : 0;
+
+    bool formats[SUBBITMAP_COUNT] = {0};
+    formats[SUBBITMAP_BGRA] = true;
+    formats[SUBBITMAP_LIBASS] = true;
+
+    struct sub_bitmap_list *subs = osd_render(vo->osd, osd_res, pts,
+                                              OSD_DRAW_SUB_ONLY, formats);
+    if (!subs)
+        return;
+
+    // Skip re-render if subtitles haven't changed
+    if (subs->change_id == p->last_sub_change_id && subs->num_items > 0) {
+        talloc_free(subs);
+        return;
+    }
+    p->last_sub_change_id = subs->change_id;
+
+    if (subs->num_items == 0) {
+        // No subtitles — clear the overlay
+        dispatch_async(dispatch_get_main_queue(), ^{
+            p->subtitle_layer.contents = nil;
+        });
+        talloc_free(subs);
+        return;
+    }
+
+    // Create a bitmap context at layer resolution for correct subtitle sizing
+    int w = layer_w;
+    int h = layer_h;
+    CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
+    CGContextRef ctx = CGBitmapContextCreate(
+        NULL, w, h, 8, w * 4, cs,
+        kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst);
+    CGColorSpaceRelease(cs);
+
+    if (!ctx) {
+        talloc_free(subs);
+        return;
+    }
+
+    // Clear to transparent
+    CGContextClearRect(ctx, CGRectMake(0, 0, w, h));
+
+    struct sub_draw_ctx draw_ctx = {
+        .cg_ctx = ctx,
+        .canvas_w = w,
+        .canvas_h = h,
+        .vo = vo,
+    };
+
+    for (int i = 0; i < subs->num_items; i++) {
+        draw_sub_bitmaps(&draw_ctx, subs->items[i]);
+    }
+
+    CGImageRef img = CGBitmapContextCreateImage(ctx);
+    CGContextRelease(ctx);
+    talloc_free(subs);
+
+    if (img) {
+        // Update subtitle layer on main thread (CALayer is not thread-safe)
+        dispatch_async(dispatch_get_main_queue(), ^{
+            p->subtitle_layer.contents = (__bridge id)img;
+            CGImageRelease(img);
+        });
+    }
+}
+
+static int preinit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    if (vo->opts->WinID == -1) {
+        MP_ERR(vo, "vo_avlayer requires --wid pointing to an "
+               "AVSampleBufferDisplayLayer\n");
+        return -1;
+    }
+
+    // WinID points to an AVSampleBufferDisplayLayer.
+    // The subtitle overlay CALayer is created and added as a sibling.
+    p->video_layer = (__bridge AVSampleBufferDisplayLayer *)
+               (void *)(intptr_t)vo->opts->WinID;
+    if (!p->video_layer) {
+        MP_ERR(vo, "vo_avlayer: invalid layer pointer\n");
+        return -1;
+    }
+
+    // Create subtitle overlay as a sibling layer on top of the video layer
+    dispatch_sync(dispatch_get_main_queue(), ^{
+        p->subtitle_layer = [CALayer layer];
+        p->subtitle_layer.backgroundColor = CGColorGetConstantColor(kCGColorClear);
+        p->subtitle_layer.contentsGravity = kCAGravityResize;
+        p->subtitle_layer.contentsScale = p->video_layer.contentsScale;
+        p->subtitle_layer.frame = p->video_layer.frame;
+        if (p->video_layer.superlayer) {
+            [p->video_layer.superlayer addSublayer:p->subtitle_layer];
+        }
+    });
+
+    CMTimebaseRef timebase = NULL;
+    OSStatus status = CMTimebaseCreateWithSourceClock(
+        kCFAllocatorDefault, CMClockGetHostTimeClock(), &timebase);
+    if (status != noErr) {
+        MP_ERR(vo, "vo_avlayer: failed to create CMTimebase\n");
+        return -1;
+    }
+    CMTimebaseSetRate(timebase, 1.0);
+    CMTimebaseSetTime(timebase, kCMTimeZero);
+    p->timebase = timebase;
+
+    p->video_layer.controlTimebase = timebase;
+    p->video_layer.videoGravity = AVLayerVideoGravityResizeAspect;
+
+    p->hwctx = (struct mp_hwdec_ctx){
+        .driver_name = "avlayer",
+        .hw_imgfmt = IMGFMT_VIDEOTOOLBOX,
+    };
+
+    int ret = av_hwdevice_ctx_create(&p->hwctx.av_device_ref,
+                                     AV_HWDEVICE_TYPE_VIDEOTOOLBOX,
+                                     NULL, NULL, 0);
+    if (ret != 0) {
+        MP_ERR(vo, "vo_avlayer: failed to create VideoToolbox device ctx\n");
+        CFRelease(timebase);
+        p->timebase = NULL;
+        return -1;
+    }
+
+    if (!vo->hwdec_devs)
+        vo->hwdec_devs = hwdec_devices_create();
+
+    hwdec_devices_add(vo->hwdec_devs, &p->hwctx);
+
+    MP_VERBOSE(vo, "vo_avlayer: initialized with subtitle overlay support\n");
+    return 0;
+}
+
+static int query_format(struct vo *vo, int format)
+{
+    return format == IMGFMT_VIDEOTOOLBOX;
+}
+
+static int reconfig(struct vo *vo, struct mp_image_params *params)
+{
+    struct priv *p = vo->priv;
+    p->src_width = params->w;
+    p->src_height = params->h;
+    p->last_sub_change_id = -1; // Force subtitle re-render on reconfig
+    MP_VERBOSE(vo, "vo_avlayer: reconfig %dx%d\n", params->w, params->h);
+    return 0;
+}
+
+static bool draw_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+
+    struct mp_image *img = frame->current;
+    if (!img)
+        return true;
+
+    CVPixelBufferRef pixbuf = (CVPixelBufferRef)img->planes[3];
+    if (!pixbuf) {
+        MP_WARN(vo, "vo_avlayer: frame has no CVPixelBuffer\n");
+        return true;
+    }
+
+    CMSampleBufferRef sample = create_sample_buffer(pixbuf, p->timebase);
+    if (!sample) {
+        MP_WARN(vo, "vo_avlayer: failed to create CMSampleBuffer\n");
+        return true;
+    }
+
+    if (p->video_layer.status == AVQueuedSampleBufferRenderingStatusFailed) {
+        MP_WARN(vo, "vo_avlayer: layer in failed state, flushing\n");
+        [p->video_layer flush];
+    }
+
+    [p->video_layer enqueueSampleBuffer:sample];
+    CFRelease(sample);
+
+    // Render subtitles to overlay layer
+    render_subtitles(vo, frame);
+
+    return true;
+}
+
+static void flip_page(struct vo *vo)
+{
+}
+
+static int control(struct vo *vo, uint32_t request, void *data)
+{
+    return VO_NOTIMPL;
+}
+
+static void uninit(struct vo *vo)
+{
+    struct priv *p = vo->priv;
+
+    hwdec_devices_remove(vo->hwdec_devs, &p->hwctx);
+    av_buffer_unref(&p->hwctx.av_device_ref);
+
+    if (p->subtitle_layer) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [p->subtitle_layer removeFromSuperlayer];
+        });
+        p->subtitle_layer = nil;
+    }
+
+    if (p->video_layer) {
+        [p->video_layer flushAndRemoveImage];
+        p->video_layer.controlTimebase = NULL;
+    }
+    if (p->timebase) {
+        CFRelease(p->timebase);
+        p->timebase = NULL;
+    }
+}
+
+const struct vo_driver video_out_avlayer = {
+    .description = "Battery-saving output with subtitle overlay",
+    .name = "avlayer",
+    .caps = VO_CAP_NORETAIN,
+    .preinit = preinit,
+    .query_format = query_format,
+    .reconfig = reconfig,
+    .control = control,
+    .draw_frame = draw_frame,
+    .flip_page = flip_page,
+    .uninit = uninit,
+    .priv_size = sizeof(struct priv),
+};
